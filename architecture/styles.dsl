styles {

    element "Person" {
        shape Person
        background #08427B
        color #ffffff
    }

    element "Software System" {
        background #1168BD
        color #ffffff
    }

    element "Container" {
        background #438DD5
        color #ffffff
    }

    element "Component" {
        background #85BBF0
        color #000000
    }

    element "Frontend" {
        shape WebBrowser
        background #63BEF2
        color #000000
    }

    element "Backend" {
        shape Hexagon
    }

    element "Database" {
        shape Cylinder
        background #438DD5
        color #ffffff
    }

}
